{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "bewit hook prompt"
      }
    ],
    "afterFileEdit": [
      {
        "command": "bewit hook edit"
      }
    ],
    "preToolUse": [
      {
        "command": "bewit hook gate"
      }
    ],
    "stop": [
      {
        "command": "bewit hook finalize",
        "loop_limit": 2
      }
    ],
    "beforeShellExecution": [
      {
        "command": "bewit hook shell"
      }
    ],
    "beforeReadFile": [
      {
        "command": "bewit hook read"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "bewit hook mcp"
      }
    ],
    "afterShellExecution": [
      {
        "command": "bewit hook exec_end"
      }
    ],
    "afterMCPExecution": [
      {
        "command": "bewit hook exec_end"
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "bewit hook edit"
      }
    ]
  }
}
