{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "archrev hook prompt"
      }
    ],
    "afterFileEdit": [
      {
        "command": "archrev hook edit"
      }
    ],
    "preToolUse": [
      {
        "command": "archrev hook gate"
      }
    ],
    "stop": [
      {
        "command": "archrev hook finalize"
      }
    ],
    "beforeShellExecution": [
      {
        "command": "archrev hook shell"
      }
    ],
    "beforeReadFile": [
      {
        "command": "archrev hook read"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "archrev hook mcp"
      }
    ]
  }
}
